# Public Google OAuth web client ID. Use the same client ID as backend/GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Optional when the API is not served through the Vite /api proxy.
VITE_API_BASE_URL=

# Optional public origin used for booking links and QR codes, e.g.
# https://tuitease.com. Defaults to the current origin.
VITE_PUBLIC_BASE_URL=
